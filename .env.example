# ============================================================================
# PFINAL_AP-IA — Variables de entorno
#
# Para producción en HuggingFace Spaces NO uses este archivo: define cada
# variable en Settings → "Variables and secrets" del Space (las que contengan
# secretos como SECRET, el resto como VARIABLE).
# ============================================================================

# --- Base de datos ---
# Vacío o "..." → cae a SQLite local en ./data/p6.db (solo dev/demo local).
#
# Producción (Supabase free, Connection pooling, modo Transaction, puerto 6543):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
#
# Postgres en Docker compose local:
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/p6     (uvicorn en compose)
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/p6  (uvicorn fuera)
DATABASE_URL=

# --- Cifrado a nivel de aplicación ---
# Clave maestra Fernet del SERVIDOR (cifra API keys de LLM y otros secretos por usuario).
# Generar UNA SOLA VEZ (luego es inmutable, si la cambias pierdes los datos cifrados):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_FERNET_KEY=

# Passphrase del servidor para el almacén de embeddings biométricos (P5).
EMBEDDING_STORE_PASSPHRASE=change-me-please

# --- LLM por defecto (Groq compartido para usuarios sin clave propia) ---
# Cuenta gratuita en https://console.groq.com
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# --- Notificaciones Telegram (bot del servidor, compartido) ---
# 1. Crear bot con @BotFather → token
# 2. Cada usuario añade su chat_id en su perfil
TELEGRAM_BOT_TOKEN=

# --- API ---
API_HOST=0.0.0.0
# Producción HF Spaces: 7860 (convención). Dev local: 8000.
API_PORT=7860
# Lista de orígenes CORS separados por coma. En producción:
#   https://<tu-proyecto>.vercel.app
CORS_ORIGINS=http://localhost:3000,https://tu-proyecto.vercel.app

# --- JWT (autenticación de sesiones) ---
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Biometría (umbrales del agente Security) ---
#   - SIN fine-tuning (solo pesos ImageNet, mode dev):      0.30 - 0.50
#   - CON fine-tuning antispoof (NUAA/CASIA/Replay-Attack): 0.85 - 0.95
#   - Para descartar liveness en pruebas:                   0.0
LIVENESS_THRESHOLD=0.50

# Checkpoint .pth con la cabeza binaria fine-tuneada del DenseNet201.
# Si el fichero existe, se cargan sus pesos; si no, queda con ImageNet.
LIVENESS_MODEL_PATH=models/liveness_kaggle.pth

# Coseno entre embeddings FaceNet/VGGFace2. Subir = más estricto.
#   - Default: 0.60 (similar autor)
#   - Más estricto: 0.75
FACE_SIMILARITY_THRESHOLD=0.60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# --- Langfuse (monitorización humana de los agentes — Fase 6) ---
# Crea una cuenta gratuita en https://cloud.langfuse.com y pega aquí los keys
# del proyecto (Settings → API keys). Si están vacíos, no se trazea nada
# (no rompe la app — degrada elegante).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
