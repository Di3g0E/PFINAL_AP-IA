# Archivos de entorno y configuración
.env
__pycache__/
*.pyc
*.pyo
*.pyd

# Entornos virtuales
venv/
env/
.venv/

# Modelos y binarios
models/*.pkl
models/*.h5
models/*.onnx
models/*.pt

# Datos pesados y sensibles
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Logs
logs/*.log

# Artefactos generados por scripts ad-hoc (grafos en JSON, exports, etc.).
artifacts/*
!artifacts/.gitkeep

# Datos biometricos cifrados (PII, no deben viajar al repo)
data/face_embeddings.bin

# Bases de datos locales (SQLite de dev)
data/*.db
data/*.db-journal
data/*.sqlite
data/*.sqlite3
data/

# IDE y sistema operativo
.vscode/
.idea/
.DS_Store
*.swp

# Documentos
doc/**.toc
doc/**.synctex.*
doc/**.out
doc/**.aux
doc/**.fls
doc/**.lof
doc/**.xml
doc/**.lot
doc/**.log
doc/**.fdb*
doc/**.blg*
doc/**.bbl*
doc/**.bcf
doc/**.run.xml
